# .env.example
# このファイルを .env にコピーして、自身の環境に合わせて編集してください。
# .env ファイルは絶対に関係者以外に共有したり、Gitにコミットしないでください。

# --- Database (Docker) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=airadio
DATABASE_URL=postgres://user:password@localhost:5432/airadio?sslmode=disable

# --- AI API (Google Gemini) ---
# https://aistudio.google.com/ で取得したAPIキーを入力
GEMINI_API_KEY=your_api_key_here

# --- Server Config ---
PORT=8080
NODE_ENV=development
